{
  "name": "mivo-levelplay-plugin",
  "version": "0.0.1",
  "description": "Mivo LevelPlay plugin for Capacitor",
  "main": "dist/plugin.cjs.js",
  "module": "dist/esm/index.js",
  "types": "dist/esm/index.d.ts",
  "files": [
    "android/src/main/",
    "android/build.gradle",
    "dist/"
  ],
  "author": "Mivo",
  "license": "MIT",
  "keywords": ["capacitor", "plugin", "levelplay", "unity"],
  "scripts": {
    "build": "npm run clean && npm run rollup",
    "clean": "rimraf ./dist",
    "rollup": "rollup -c rollup.config.js",
    "watch": "rollup -c rollup.config.js --watch"
  },
  "capacitor": {
    "android": {
      "src": "android"
    }
  },
  "devDependencies": {
    "@capacitor/android": "^6.0.0",
    "@capacitor/core": "^6.0.0",
    "rimraf": "^5.0.5",
    "rollup": "^4.0.0"
  },
  "peerDependencies": {
    "@capacitor/core": "^6.0.0"
  }
}
