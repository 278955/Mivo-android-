          const { error: updateError } = await sb.from("lessons").update({ pdf_path: path }).eq("id", row.id);
          if (updateError) { await sb.storage.from("mivo-lessons").remove([path]); await sb.from("lessons").delete().eq("id", row.id); throw updateError; }
