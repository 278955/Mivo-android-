    function renderLessons() {
      const search = $("lessonSearch").value.trim().toLowerCase();

      const filtered = loadedLessons.filter((lesson) => {
        const profile = profileRow || {};
        const scoped = Boolean(lesson.institution_name || lesson.department || lesson.programme || lesson.study_level);
        const matchesProfile = !scoped || (
          (!lesson.institution_type || lesson.institution_type === profile.institution_type) &&
          (!lesson.institution_name || lesson.institution_name === profile.institution_name) &&
          (!lesson.department || lesson.department === profile.department) &&
          (!lesson.programme || lesson.programme === profile.programme) &&
          (!lesson.study_level || lesson.study_level === profile.study_level)
        );
        return matchesProfile && [lesson.title, lesson.subject, lesson.description, lesson.course_name]
          .some((value) => String(value || "").toLowerCase().includes(search));
      });

      $("lessonsList").innerHTML = filtered.map((lesson, index) => `
        <article class="lesson">
          <span class="tag">${escapeHtml(lesson.subject || "Lesson")}</span>
          <h3 style="margin-top:10px">${escapeHtml(lesson.title || "Untitled lesson")}</h3>
          <p class="muted">${escapeHtml(lesson.description || "")}</p>
          ${lesson.pdf_path ? `<button class="btn secondary small-btn" type="button" data-download-lesson="${index}">Download PDF</button>` : `<button class="btn secondary small-btn" type="button" data-lesson-index="${index}">Read lesson</button>`}
          <div class="lesson-content hidden" id="lessonContent${index}">${escapeHtml(lesson.content || "This lesson does not have text content.")}</div>
        </article>
      `).join("") || '<p class="muted">No matching lessons found.</p>';

      $("lessonsList").querySelectorAll("[data-lesson-index]").forEach((button) => {
        button.addEventListener("click", () => {
          const content = $("lessonContent" + button.dataset.lessonIndex);
          content.classList.toggle("hidden");
          button.textContent = content.classList.contains("hidden") ? "Read lesson" : "Close lesson";
        });
      });
      $("lessonsList").querySelectorAll("[data-download-lesson]").forEach((button) => {
        button.addEventListener("click", async () => {
          const lesson = filtered[Number(button.dataset.downloadLesson)];
          if (!lesson?.pdf_path || !sb) return;
          button.disabled = true; button.textContent = "Preparing download…";
          try {
            const { data, error } = await sb.storage.from("mivo-lessons").createSignedUrl(lesson.pdf_path, 300, { download: lesson.pdf_filename || true });
            if (error) throw error;
            window.open(data.signedUrl, "_blank", "noopener");
          } catch (error) { alert("Could not prepare PDF download: " + (error.message || "Unknown error")); }
          finally { button.disabled = false; button.textContent = "Download PDF"; }
        });
      });
    }

    $("lessonSearch").addEventListener("input", renderLessons);
    $("refreshLessons").addEventListener("click", loadLessons);

