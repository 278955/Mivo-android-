      const title = $id("mivoAnnouncementTitle").value.trim(), message = $id("mivoAnnouncementMessage").value.trim();
      const { error } = await client.from("announcements").insert({ title, message, published:true, created_by:user.id });
      if (error) throw error;
      status.className="message success"; status.textContent="Announcement published."; form.reset(); await loadMivoAnnouncements();
    } catch (e) { status.className="message error"; status.textContent="Could not publish: " + (e.message || "Configure the announcements table and owner INSERT policy first."); }
    finally { button.disabled = false; }
  });
  $id("refreshAnnouncements")?.addEventListener("click", loadMivoAnnouncements);
  document.addEventListener("click", event => { if (event.target.closest('[data-go="dashboardView"]')) setTimeout(loadMivoAnnouncements, 300); });
  // Expose only the refresh function, not credentials.
  window.mivoRefreshAnnouncements = loadMivoAnnouncements;

  // Stronger pull-to-refresh: only starts at the top, avoids form controls, and refreshes the active view.
  const indicator = document.createElement("div");
  indicator.id = "mivoPullRefresh";
  indicator.setAttribute("role", "status");
  indicator.setAttribute("aria-live", "polite");
  indicator.textContent = "↓ Pull down to refresh";
  document.body.appendChild(indicator);
  let startY = 0, delta = 0, tracking = false, busy = false, prevented = false;
  const atPageTop = () => Math.max(window.scrollY || 0, document.documentElement.scrollTop || 0, document.body.scrollTop || 0) <= 1;
  const ignorePullTarget = target => !!target?.closest('input,textarea,select,button,a,[contenteditable="true"],.bottom-nav,[data-no-pull-refresh]');
  document.addEventListener("touchstart", e => {
    if (busy || e.touches.length !== 1 || !atPageTop() || ignorePullTarget(e.target)) { tracking = false; return; }
    startY = e.touches[0].clientY; delta = 0; tracking = true; prevented = false;
  }, { passive: true });
  document.addEventListener("touchmove", e => {
    if (!tracking || e.touches.length !== 1) return;
    delta = e.touches[0].clientY - startY;
    if (delta <= 0 || !atPageTop()) { indicator.classList.remove("visible"); return; }
    if (delta > 8 && e.cancelable) { e.preventDefault(); prevented = true; }
    indicator.classList.add("visible");
    indicator.textContent = delta >= 95 ? "↑ Release to refresh Mivo" : `↓ Pull to refresh (${Math.min(99, Math.round(delta / 95 * 100))}%)`;
  }, { passive: false });
  document.addEventListener("touchend", async () => {
    if (!tracking) return;
    tracking = false;
    if (delta < 95 || busy) { indicator.classList.remove("visible"); return; }
    busy = true;
    indicator.innerHTML = '<span class="md-spinner"></span>Refreshing Mivo…';
    try {
      if (typeof window.mivoRefreshCurrentView !== "function") throw new Error("Refresh service is not ready.");
      await window.mivoRefreshCurrentView();
      await loadMivoAnnouncements();
      indicator.textContent = "✓ Mivo refreshed";
    } catch (error) {
      indicator.textContent = "Refresh failed — check your connection";
      console.warn("Mivo pull-to-refresh failed:", error);
    } finally {
      setTimeout(() => indicator.classList.remove("visible"), 1100);
      busy = false; delta = 0; prevented = false;
    }
  }, { passive: true });
  document.addEventListener("touchcancel", () => { tracking = false; delta = 0; indicator.classList.remove("visible"); }, { passive: true });
})();
</script>

<script>
/* Publisher navigation fallback: keeps the existing publisher forms and Supabase logic intact. */
(function () {
  const targets = {
    jumpToDailyQuizPublisher: "pdfQuestionImporter",
    jumpToMockExamPublisher: "mockPdfQuestionImporter",
    jumpToLessonPublisher: "lessonPublisherCard"
  };
  function navigateToPublisher(buttonId) {
