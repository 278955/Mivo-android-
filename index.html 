      if (invalid !== -1) { showMessage("mockPdfImportMessage", `Question ${invalid + 1} needs a question, four different non-empty options, and a correct answer A–D.`, "error"); return; }
      const normalizeQuestion = value => String(value || "").toLocaleLowerCase().replace(/[^\p{L}\p{N}]+/gu, " ").trim();
      const duplicateIndexes = findMockPdfDuplicateIndexes(reviewed);
      if (duplicateIndexes.length) {
        showMessage("mockPdfImportMessage", `Possible duplicate questions: ${duplicateIndexes.map(n => `#${n}`).join(", ")}. They are highlighted in red in the preview. Edit the repeated question text before publishing.`, "error");
        renderMockPdfPreview();
        return;
      }
      setButtonBusy(button, true, "Validating mock questions…");
      showMessage("mockPdfImportMessage", `Validating ${reviewed.length} mock question(s)…`, "info");
      let imported = 0;
      try {
        const { data: existingRows, error: existingError } = await sb.from("quiz_questions")
          .select("subject,question_text,exam_type")
          .eq("exam_type", examType)
          .eq("subject", subject);
        if (existingError) throw existingError;
        const existingKeys = new Set((existingRows || []).map(row => `${row.exam_type}::${String(row.subject || "").toLowerCase()}::${normalizeQuestion(row.question_text)}`));
        const existingDuplicateIndexes = reviewed.map((q, i) => existingKeys.has(`${q.exam_type}::${q.subject.toLowerCase()}::${normalizeQuestion(q.question_text)}`) ? i + 1 : null).filter(Boolean);
        if (existingDuplicateIndexes.length) throw new Error(`These questions already exist in the ${examType.toUpperCase()} bank for ${subject}: ${existingDuplicateIndexes.map(n => `#${n}`).join(", ")}. Review and edit those questions before importing.`);
        for (const q of reviewed) {
          const { data, error } = await sb.from("quiz_questions").insert({
            learning_path:q.learning_path, subject:q.subject, exam_type:q.exam_type,
            question_text:q.question_text, options:q.options, explanation:q.explanation,
            created_by:currentUser.id, published:false
          }).select("id").single();
          if (error) throw error;
          const { error:keyError } = await sb.from("quiz_answer_keys").upsert({
            question_id:data.id, correct_answer:q.options["ABCD".indexOf(q.correct_option)], updated_at:new Date().toISOString()
          }, { onConflict:"question_id" });
          if (keyError) { await sb.from("quiz_questions").delete().eq("id", data.id); throw keyError; }
          const { error:publishError } = await sb.from("quiz_questions").update({ published:true }).eq("id", data.id);
          if (publishError) {
            await sb.from("quiz_answer_keys").delete().eq("question_id", data.id);
            await sb.from("quiz_questions").delete().eq("id", data.id);
            throw publishError;
          }
          imported++;
        }
        extractedMockPdfQuestions = [];
        $("mockPdfPreviewArea").classList.add("hidden");
        $("mockQuestionPdf").value = "";
        await loadQuestionBank();
        showMessage("mockPdfImportMessage", `Success! ${imported} ${examType.toUpperCase()} mock question(s) published under ${subject}.`, "success");
      } catch (error) {
        console.error("Mock PDF import failed:", error);
        showMessage("mockPdfImportMessage", `Published ${imported} question(s) before the error. Remaining questions were not imported: ${error.message || "Unknown error"}.`, "error");
        if (imported) await loadQuestionBank();
      } finally { setButtonBusy(button, false); }
    });

