let adminQuestions = [];
let adminAnswerKeys = {};
const selectedQuestionIds = new Set();
const MAX_BULK_QUESTION_SELECTION = 100;

function resetQuestionForm() {
  $("questionForm").reset();
  $("questionId").value = "";
  $("questionPublished").checked = false;
  $("saveQuestionButton").textContent = "Save question";
  clearMessage("questionBankMessage");
}

async function loadQuestionBank() {
  const target = $("questionBankList");
  target.textContent = "Loading questions…";

  if (!sb || !currentUser || profileRow?.role !== "admin") {
    target.textContent = "Owner permission is required.";
    return;
  }

  try {
    const { data: questions, error } = await sb
      .from("quiz_questions")
      .select(
        "id,learning_path,subject,exam_type,question_text,options,explanation,published,created_at"
      )
      .order("created_at", { ascending: false });

    if (error) throw error;

    adminQuestions = questions || [];
    adminAnswerKeys = {};

    if (adminQuestions.length) {
      const ids = adminQuestions.map((q) => q.id);

      const { data: keys, error: keyError } = await sb
        .from("quiz_answer_keys")
        .select("question_id,correct_answer")
        .in("question_id", ids);

      if (keyError) throw keyError;

      (keys || []).forEach((key) => {
        adminAnswerKeys[String(key.question_id)] =
          key.correct_answer;
      });
    }

    refreshQuestionSubjectFilter();
    renderQuestionBank();

    showMessage(
      "questionBankMessage",
      `${adminQuestions.length} question(s) loaded.`,
      "success"
    );
  } catch (error) {
    target.textContent = "Unable to load questions.";
    showMessage(
      "questionBankMessage",
      "Question bank error: " + (error.message || "Unknown error"),
      "error"
    );
  }
}

function questionBankLabel(path) {
  return ({ jamb: "JAMB MOCK QUESTIONS", waec_neco: "WAEC / NECO", higher_institution: "HIGHER INSTITUTIONS" })[path] || path || "Uncategorised";
}

function getQuestionsForBank(path) {
  // Keep the owner mock banks separate from the general Daily Quiz pool.
  return adminQuestions.filter(q => {
    const learningPath = String(q.learning_path || "");
    const examType = String(q.exam_type || "").toLowerCase();
    if (learningPath !== String(path)) return false;
    if (path === "jamb") return examType === "jamb";
    if (path === "waec_neco") return examType === "waec" || examType === "neco";
    if (path === "higher_institution") return examType === "higher_institution";
    return false;
  });
}

function refreshQuestionSubjectFilter() {
  const category = $("questionBankCategory");
  const select = $("questionSubjectFilter");
  const counts = $("questionBankSubjectCounts");
  if (!select || !category || !counts) return;
  const path = category.value;
  const current = select.value;
  if (!path) {
    select.innerHTML = '<option value="">Choose a bank first</option>';
    select.disabled = true;
    $("questionSearch").disabled = true;
    counts.innerHTML = '<p class="muted">Choose a question bank to view subjects and question counts.</p>';
    return;
  }
  const bankQuestions = getQuestionsForBank(path);
  const subjectCounts = new Map();
  bankQuestions.forEach(q => {
    const subject = String(q.subject || "Uncategorised").trim() || "Uncategorised";
    subjectCounts.set(subject, (subjectCounts.get(subject) || 0) + 1);
  });
  const subjects = [...subjectCounts.keys()].sort((a, b) => a.localeCompare(b));
  counts.innerHTML = subjects.length ? subjects.map(subject => `
    <div class="lesson"><strong>${escapeHtml(subject)}</strong><div class="stat-number">${subjectCounts.get(subject)}</div><p class="small">saved question(s)</p></div>
  `).join("") : '<p class="muted">No questions saved in this bank yet.</p>';
  select.innerHTML = '<option value="">Choose a subject</option>' + subjects.map(subject =>
    `<option value="${escapeHtml(subject)}">${escapeHtml(subject)} (${subjectCounts.get(subject)})</option>`
  ).join("");
  select.disabled = subjects.length === 0;
  $("questionSearch").disabled = true;
  if (subjects.includes(current)) select.value = current;
  else select.value = "";
  renderQuestionBank();
  refreshBulkDeleteSubjectOptions();
}

function refreshBulkDeleteSubjectOptions() {
  const category = $("bulkDeleteCategory");
  const subjectSelect = $("bulkDeleteSubject");
  if (!category || !subjectSelect) return;
  const path = category.value;
  if (!path) {
    subjectSelect.innerHTML = '<option value="">Choose bank first</option>';
    subjectSelect.disabled = true;
    $("bulkDeleteBankSubject").disabled = true;
    return;
  }
  const subjects = [...new Set(getQuestionsForBank(path).map(q => String(q.subject || "Uncategorised").trim() || "Uncategorised"))].sort((a,b) => a.localeCompare(b));
  subjectSelect.innerHTML = '<option value="">Choose a subject</option>' + subjects.map(subject => {
    const count = getQuestionsForBank(path).filter(q => (String(q.subject || "Uncategorised").trim() || "Uncategorised") === subject).length;
    return `<option value="${escapeHtml(subject)}">${escapeHtml(subject)} (${count})</option>`;
  }).join("");
  subjectSelect.disabled = subjects.length === 0;
  $("bulkDeleteBankSubject").disabled = true;
}

function renderQuestionBank() {
  const target = $("questionBankList");
  const term = $("questionSearch").value.trim().toLowerCase();
  const selectedSubject = $("questionSubjectFilter").value;
  const selectedPath = $("questionBankCategory").value;
  if (!selectedPath || !selectedSubject) {
    target.innerHTML = '<p class="muted">Choose a question bank and a subject above to display its questions. The full bank is kept collapsed until you choose.</p>';
    updateBulkQuestionControls([]);
    return;
  }
  const filtered = adminQuestions.filter((q) =>
    String(q.learning_path || "") === selectedPath &&
    String(q.subject || "Uncategorised").trim() === selectedSubject &&
    [q.question_text, q.subject, q.learning_path, q.exam_type].some((value) => String(value || "").toLowerCase().includes(term))
  );

  updateBulkQuestionControls(filtered);

  if (!filtered.length) {
    target.innerHTML =
      '<p class="muted">No matching questions found.</p>';
    return;
  }

  target.innerHTML = filtered.map((q) => `
    <article class="lesson">
      <label class="choice" style="margin:0 0 10px">
        <input type="checkbox" data-question-select="${escapeHtml(q.id)}"
          ${selectedQuestionIds.has(String(q.id)) ? "checked" : ""}>
        <span>Select this question</span>
      </label>
      <span class="tag">${escapeHtml(q.learning_path)}</span>
      <span class="tag">${escapeHtml(q.subject)}</span>
      <p class="small">
        ${q.published ? "Published" : "Draft"}
        · ${escapeHtml(q.exam_type || "Uncategorised")}
        · ID ${escapeHtml(q.id)}
      </p>

      <p><strong>${escapeHtml(q.question_text)}</strong></p>

      <div class="muted">
        ${(Array.isArray(q.options) ? q.options : [])
          .map((option, i) =>
            `<p>${String.fromCharCode(65 + i)}. ${
              escapeHtml(option)
            }</p>`
          ).join("")}
      </div>

      <div class="button-row">
        <button class="btn secondary small-btn"
          type="button" data-question-edit="${escapeHtml(q.id)}">
          Edit
        </button>

        <button class="btn ${q.published ? "secondary" : "primary"} small-btn"
          type="button" data-question-toggle="${escapeHtml(q.id)}">
          ${q.published ? "Unpublish" : "Publish"}
        </button>

        <button class="btn danger small-btn"
          type="button" data-question-delete="${escapeHtml(q.id)}">
          Delete
        </button>
      </div>
    </article>
  `).join("");

  target.querySelectorAll("[data-question-select]").forEach((checkbox) => {
    checkbox.addEventListener("change", () => {
      const id = String(checkbox.dataset.questionSelect);
      if (checkbox.checked) {
        if (selectedQuestionIds.size >= MAX_BULK_QUESTION_SELECTION) {
          checkbox.checked = false;
          showMessage("questionBankMessage", "You can select a maximum of 100 questions at a time.", "error");
          return;
        }
        selectedQuestionIds.add(id);
      } else {
        selectedQuestionIds.delete(id);
      }
      updateBulkQuestionControls(filtered);
    });
  });

  target.querySelectorAll("[data-question-edit]").forEach((button) => {
    button.addEventListener("click", () => {
      editQuestion(button.dataset.questionEdit);
    });
  });

  target.querySelectorAll("[data-question-toggle]").forEach((button) => {
    button.addEventListener("click", () => {
      toggleQuestionPublished(button.dataset.questionToggle);
    });
  });

  target.querySelectorAll("[data-question-delete]").forEach((button) => {
    button.addEventListener("click", () => {
      deleteQuestion(button.dataset.questionDelete);
    });
  });
}

function getVisibleQuestionMatches() {
  const term = $("questionSearch").value.trim().toLowerCase();
  const path = $("questionBankCategory")?.value;
  const subject = $("questionSubjectFilter")?.value;
  if (!path || !subject) return [];
  return adminQuestions.filter((q) =>
    String(q.learning_path || "") === path &&
    String(q.subject || "Uncategorised").trim() === subject &&
    [q.question_text, q.subject, q.learning_path, q.exam_type].some((value) => String(value || "").toLowerCase().includes(term))
  );
}

function updateBulkQuestionControls(visibleQuestions = getVisibleQuestionMatches()) {
  const count = selectedQuestionIds.size;
  const countEl = $("selectedQuestionCount");
  const selectAll = $("selectAllVisibleQuestions");
  const deleteButton = $("bulkDeleteQuestions");
  if (countEl) countEl.textContent = `${count} / ${MAX_BULK_QUESTION_SELECTION} selected`;
  if (deleteButton) deleteButton.disabled = count === 0;

  if (selectAll) {
    const visibleIds = visibleQuestions.map((q) => String(q.id));
    const selectedVisibleCount = visibleIds.filter((id) => selectedQuestionIds.has(id)).length;
    selectAll.checked = visibleIds.length > 0 && selectedVisibleCount === visibleIds.length;
    selectAll.indeterminate = selectedVisibleCount > 0 && selectedVisibleCount < visibleIds.length;
    selectAll.disabled = visibleIds.length === 0;
  }
}

$("selectAllVisibleQuestions").addEventListener("change", () => {
  const visible = getVisibleQuestionMatches();
  if ($("selectAllVisibleQuestions").checked) {
    for (const q of visible) {
      const id = String(q.id);
      if (!selectedQuestionIds.has(id) && selectedQuestionIds.size >= MAX_BULK_QUESTION_SELECTION) break;
      selectedQuestionIds.add(id);
    }
    if (visible.some((q) => !selectedQuestionIds.has(String(q.id)))) {
      showMessage("questionBankMessage", "Selection stopped at 100 questions. Unselect some questions to select others.", "info");
    }
  } else {
    visible.forEach((q) => selectedQuestionIds.delete(String(q.id)));
  }
  renderQuestionBank();
});

$("clearQuestionSelection").addEventListener("click", () => {
  selectedQuestionIds.clear();
  renderQuestionBank();
  clearMessage("questionBankMessage");
});

async function bulkDeleteSelectedQuestions() {
  if (!sb || !currentUser || profileRow?.role !== "admin") {
    showMessage("questionBankMessage", "Only an authorised owner can delete questions.", "error");
    return;
  }
  const ids = Array.from(selectedQuestionIds).slice(0, MAX_BULK_QUESTION_SELECTION);
  if (!ids.length) {
    showMessage("questionBankMessage", "Select at least one question first.", "info");
    return;
  }
  const chosen = ids.map(id => adminQuestions.find(q => String(q.id) === id)).filter(Boolean);
  const subjectSummary = [...new Set(chosen.map(q => q.subject || "Uncategorised"))].join(", ");
  const bankSummary = [...new Set(chosen.map(q => questionBankLabel(q.learning_path)))].join(", ");
  if (!window.confirm(`PERMANENTLY DELETE ${chosen.length} selected question(s)?\nBank: ${bankSummary}\nSubject(s): ${subjectSummary}\nTheir answer keys will also be deleted. This cannot be undone.`)) return;

  const deleteButton = $("bulkDeleteQuestions");
  deleteButton.disabled = true;
  try {
    // Delete child answer-key rows first, then delete the question rows.
    const { error: keyError } = await sb.from("quiz_answer_keys").delete().in("question_id", ids);
    if (keyError) throw keyError;

    const { data, error } = await sb.from("quiz_questions").delete().in("id", ids).select("id");
    if (error) throw error;

    const deletedCount = (data || []).length;
    selectedQuestionIds.clear();
    if ($("questionId").value && ids.includes(String($("questionId").value))) resetQuestionForm();
    await loadQuestionBank();
    showMessage("questionBankMessage", `${deletedCount} question(s) permanently deleted.`, "success");
  } catch (error) {
    showMessage("questionBankMessage", `Bulk deletion failed: ${error.message || "Unknown error"}. Check the Supabase owner DELETE policies and whether another table prevents deleting these questions.`, "error");
    await loadQuestionBank();
  } finally {
    updateBulkQuestionControls();
  }
}

async function bulkDeleteSelectedBankSubject() {
  if (!sb || !currentUser || profileRow?.role !== "admin") {
    showMessage("questionBankMessage", "Only an authorised owner can delete questions.", "error");
    return;
  }
  const path = $("bulkDeleteCategory").value;
  const subject = $("bulkDeleteSubject").value;
  if (!path || !subject) {
    showMessage("questionBankMessage", "Choose the exam bank and subject before deleting.", "error");
    return;
  }
  const matches = adminQuestions.filter(q => String(q.learning_path || "") === path && (String(q.subject || "Uncategorised").trim() || "Uncategorised") === subject);
  if (!matches.length) {
    showMessage("questionBankMessage", "No questions match that bank and subject.", "info");
    return;
  }
  if (matches.length > MAX_BULK_QUESTION_SELECTION) {
    showMessage("questionBankMessage", `This subject has ${matches.length} questions. For safety, delete at most ${MAX_BULK_QUESTION_SELECTION} selected questions at a time using the selection tool below.`, "error");
    return;
  }
  const label = questionBankLabel(path);
  if (!window.confirm(`FINAL CONFIRMATION\nPermanently delete ${matches.length} question(s)?\nBank: ${label}\nSubject: ${subject}\nAnswer keys will also be deleted. This cannot be undone.`)) return;
  const button = $("bulkDeleteBankSubject");
  button.disabled = true;
  button.textContent = "Deleting…";
  try {
    const ids = matches.map(q => q.id);
    const { error: keyError } = await sb.from("quiz_answer_keys").delete().in("question_id", ids);
    if (keyError) throw keyError;
    const { data, error } = await sb.from("quiz_questions").delete().in("id", ids).select("id");
    if (error) throw error;
    const deleted = (data || []).length;
    ids.forEach(id => selectedQuestionIds.delete(String(id)));
    await loadQuestionBank();
    showMessage("questionBankMessage", `${deleted} question(s) deleted from ${label} → ${subject}.`, "success");
  } catch (error) {
    showMessage("questionBankMessage", `Bulk deletion failed: ${error.message || "Unknown error"}. Check Supabase owner DELETE policies and database relationships.`, "error");
    await loadQuestionBank();
  } finally {
    button.textContent = "Delete questions in selected bank and subject";
    refreshBulkDeleteSubjectOptions();
  }
}

$("bulkDeleteQuestions").addEventListener("click", bulkDeleteSelectedQuestions);
$("bulkDeleteBankSubject").addEventListener("click", bulkDeleteSelectedBankSubject);
$("questionBankCategory").addEventListener("change", () => {
  selectedQuestionIds.clear();
  refreshQuestionSubjectFilter();
});
$("questionSubjectFilter").addEventListener("change", () => {
  $("questionSearch").disabled = !$("questionSubjectFilter").value;
  selectedQuestionIds.clear();
  renderQuestionBank();
});
$("questionSearch").addEventListener("input", renderQuestionBank);
$("bulkDeleteCategory").addEventListener("change", refreshBulkDeleteSubjectOptions);
$("bulkDeleteSubject").addEventListener("change", () => {
  $("bulkDeleteBankSubject").disabled = !$("bulkDeleteCategory").value || !$("bulkDeleteSubject").value;
});

function editQuestion(id) {
  const q = adminQuestions.find(
    (item) => String(item.id) === String(id)
  );

  if (!q) return;

  const options = Array.isArray(q.options) ? q.options : [];

  $("questionId").value = q.id;
  $("questionPath").value = q.learning_path;
  $("questionSubject").value = q.subject;
  $("questionExamType").value = q.exam_type || "jamb";
  $("questionText").value = q.question_text;
  $("questionExplanation").value = q.explanation || "";
  $("questionPublished").checked = q.published;

  ["optionA", "optionB", "optionC", "optionD"].forEach((id, i) => {
    $(id).value = options[i] || "";
  });

  const correctAnswer = adminAnswerKeys[String(q.id)];
  const correctIndex = options.indexOf(correctAnswer);

  $("correctOption").value =
    correctIndex >= 0 ? "ABCD"[correctIndex] : "A";

  $("saveQuestionButton").textContent = "Update question";

  showMessage(
    "questionBankMessage",
    "Editing question " + q.id + ". Save your changes when ready.",
    "info"
  );

  $("questionBankCard").scrollIntoView({ behavior: "smooth" });
}

$("questionForm").addEventListener("submit", async (event) => {
  event.preventDefault();

  if (!sb || !currentUser || profileRow?.role !== "admin") {
    showMessage(
      "questionBankMessage",
      "Only an authorised owner can manage questions.",
      "error"
    );
    return;
  }

  const id = $("questionId").value;
  const subject = $("questionSubject").value.trim();
  const questionText = $("questionText").value.trim();

  const options = [
    $("optionA").value.trim(),
    $("optionB").value.trim(),
    $("optionC").value.trim(),
    $("optionD").value.trim()
  ];

  if (!subject || !questionText || options.some((o) => !o)) {
    showMessage(
      "questionBankMessage",
      "Complete the subject, question and all four options.",
      "error"
    );
    return;
  }

  if (new Set(options.map((o) => o.toLowerCase())).size !== 4) {
    showMessage(
      "questionBankMessage",
      "Please provide four different answer options.",
      "error"
    );
    return;
  }

  const correctIndex = "ABCD".indexOf($("correctOption").value);
  const correctAnswer = options[correctIndex];

  const payload = {
    learning_path: $("questionPath").value,
    subject,
    exam_type: $("questionExamType").value,
    question_text: questionText,
    options,
    explanation: $("questionExplanation").value.trim() || null,
    created_by: currentUser.id,
    published: false
  };

  const button = $("saveQuestionButton");
  button.disabled = true;
  button.textContent = "Saving…";

  try {
    let questionId = id;

    if (id) {
      // Unpublish while updating the question and its answer key.
      const { error } = await sb
        .from("quiz_questions")
        .update({ ...payload, published: false })
        .eq("id", id);

      if (error) throw error;
    } else {
      const { data, error } = await sb
        .from("quiz_questions")
        .insert(payload)
        .select("id")
        .single();

      if (error) throw error;
      questionId = data.id;
    }

    // Upsert the answer key separately from the public question.
    const { error: keyError } = await sb
      .from("quiz_answer_keys")
      .upsert(
        {
          question_id: questionId,
          correct_answer: correctAnswer,
          updated_at: new Date().toISOString()
        },
        { onConflict: "question_id" }
      );

    if (keyError) throw keyError;

    // Publish only after the answer key has been saved.
    const { error: publishError } = await sb
      .from("quiz_questions")
      .update({ published: $("questionPublished").checked })
      .eq("id", questionId);

    if (publishError) throw publishError;

    resetQuestionForm();
    await loadQuestionBank();

    showMessage(
      "questionBankMessage",
      "Question and answer key saved successfully.",
      "success"
    );
  } catch (error) {
    showMessage(
      "questionBankMessage",
      "Could not save the question: " + (error.message || "Unknown error") +
      ". If an update failed, check whether the question is still unpublished.",
      "error"
    );
  } finally {
    button.disabled = false;
    button.textContent = $("questionId").value
      ? "Update question"
      : "Save question";
  }
});

