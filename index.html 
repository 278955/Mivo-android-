    function updateLearningPathFields() {
      const path = $("learningPath").value;
      const secondary = path === "waec_neco";
      const jamb = path === "jamb";
      const higher = path === "higher_institution";

      $("secondaryOptions").classList.toggle("hidden", !secondary);
      $("jambOptions").classList.toggle("hidden", !jamb);
      $("higherOptions").classList.toggle("hidden", !higher);
      $("subjectOptions").classList.toggle("hidden", !secondary && !jamb);

      $("examChoice").required = secondary;
      $("schoolLevel").required = secondary;
      $("jambLevel").required = jamb;
      $("subjectsHeading").textContent = jamb ? "Choose your four JAMB subject combination" : "Choose your nine WAEC / NECO subjects";
      $("subjectsHelp").textContent = jamb
        ? "Select exactly four subjects, including English Language, to match your JAMB registration."
        : "Select exactly nine subjects you take for WAEC/NECO.";
      document.querySelectorAll(".subject-choice").forEach(box => {
        box.disabled = !secondary && !jamb;
        box.required = false;
      });
      updateSelectedSubjectCount();
      ["institutionName", "faculty", "programme", "studyLevel", "semester"].forEach((id) => {
        $(id).required = higher;
      });
    }

    function updateSelectedSubjectCount() {
      const checked = [...document.querySelectorAll(".subject-choice:checked")];
      const path = $("learningPath")?.value;
      const limit = path === "jamb" ? 4 : path === "waec_neco" ? 9 : 0;
      const count = $("subjectsCount");
      if (count) count.textContent = limit ? `${checked.length} of ${limit} subjects selected` : `${checked.length} selected`;
      document.querySelectorAll(".subject-choice").forEach(box => {
        box.disabled = !!limit && !box.checked && checked.length >= limit;
      });
    }

    $("learningPath").addEventListener("change", updateLearningPathFields);

    function renderSubjects(selected = []) {
      $("subjectsList").innerHTML = subjects.map((subject) => `
        <label class="choice">
          <input type="checkbox" class="subject-choice" value="${escapeHtml(subject)}"
            ${selected.includes(subject) ? "checked" : ""}>
