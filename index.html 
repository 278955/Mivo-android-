      const button = $("uploadBulkLessonPdfs");
      const files = Array.from(bulkPdfInput?.files || []);
      if (!sb || !currentUser || profileRow?.role !== "admin") { showMessage(messageId, "Owner permission and Supabase connection are required.", "error"); return; }
      if (!files.length || files.length > 20) { showMessage(messageId, "Choose between 1 and 20 PDF files.", "error"); return; }
