      } catch (error) { failed.push(error.message || "Unknown error"); showMessage(messageId, `${completed} uploaded; stopped because: ${failed.join("; ")}`, "error"); await loadAdminLessons(); await loadLessons(); }
      finally { button.disabled = false; }
