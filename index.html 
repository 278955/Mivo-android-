    $("askTeacher").addEventListener("click", async () => {
      const question = $("teacherQuestion").value.trim();
      const button = $("askTeacher");
      if (!currentUser || !sb) {
        showMessage("teacherMessage", "Please sign in before using the AI Teacher.", "error");
        return;
      }
      if (!question) {
        showMessage("teacherMessage", "Type a message first.", "error");
        return;
      }
      if (question.length > 3000) {
        showMessage("teacherMessage", "Please keep your message under 3,000 characters.", "error");
        return;
      }
      const previousConversationLength = teacherConversation.length;
      button.disabled = true;
      button.textContent = "Mivo is thinking…";
      $("teacherQuestion").disabled = true;
      showMessage("teacherMessage", "Sending your message…", "info");
      addTeacherChatMessage("user", question);
      teacherConversation.push({ role: "user", content: question });
      const replyBody = addTeacherChatMessage("assistant", "");
      try {
        const { data: sessionData, error: sessionError } = await sb.auth.getSession();
        if (sessionError) throw sessionError;
        const accessToken = sessionData?.session?.access_token;
        if (!accessToken) throw new Error("Your session has expired. Please sign in again.");

        // The Edge Function expects a messages array and returns OpenAI SSE streaming data.
        const response = await fetch(`${SUPABASE_URL}/functions/v1/ai-teacher`, {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
            "apikey": SUPABASE_KEY,
            "Authorization": `Bearer ${accessToken}`
          },
          body: JSON.stringify({ messages: teacherConversation.slice(-30) })
        });
        if (!response.ok) {
          let detail = "The AI Teacher request failed.";
          try { const errBody = await response.json(); detail = errBody.error || detail; } catch (_) {}
          throw new Error(detail);
        }
        if (!response.body) throw new Error("The AI Teacher returned an empty response.");

        const reader = response.body.getReader();
        const decoder = new TextDecoder();
        let buffer = "";
        let answer = "";
        let streamDone = false;
        while (!streamDone) {
          const { value, done } = await reader.read();
          if (done) break;
          buffer += decoder.decode(value, { stream: true });
          const lines = buffer.split("\n");
          buffer = lines.pop() || "";
          for (const line of lines) {
            const trimmed = line.trim();
            if (!trimmed.startsWith("data:")) continue;
            const payload = trimmed.slice(5).trim();
            if (!payload || payload === "[DONE]") { if (payload === "[DONE]") streamDone = true; continue; }
            try {
              const packet = JSON.parse(payload);
              const delta = packet.choices?.[0]?.delta?.content;
              if (typeof delta === "string" && delta) {
                answer += delta;
                replyBody.textContent = answer;
                $("teacherChat").scrollTop = $("teacherChat").scrollHeight;
              }
              if (packet.error?.message) throw new Error(packet.error.message);
            } catch (parseError) {
              if (parseError instanceof SyntaxError) continue;
              throw parseError;
            }
          }
        }
        answer = answer.trim();
        if (!answer) throw new Error("The AI Teacher returned no answer. Please try again.");
        teacherConversation[teacherConversation.length - 1] = { role: "user", content: question };
        teacherConversation.push({ role: "assistant", content: answer });
        // Keep the payload within the Edge Function's 30-message limit.
        if (teacherConversation.length > 30) teacherConversation.splice(0, teacherConversation.length - 30);
        showMessage("teacherMessage", "Reply received.", "success");
        $("teacherQuestion").value = "";
      } catch (error) {
        replyBody.textContent = "Sorry, I couldn't get a reply. " + (error.message || "Please try again.");
        // Remove only this failed message; preserve earlier successful conversation turns.
        teacherConversation.length = previousConversationLength;
        showMessage("teacherMessage", error.message || "Could not reach the AI Teacher. Check the Supabase function and secret configuration.", "error");
      } finally {
        button.disabled = false;
        button.textContent = "Send message";
        $("teacherQuestion").disabled = false;
        $("teacherQuestion").focus();
      }
    });

