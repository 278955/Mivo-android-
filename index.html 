    }

    $("toggleAuth").addEventListener("click", () => {
      isSignup = !isSignup;
      clearMessage("authMessage");
      updateAuthForm();
    });

    function friendlyError(error) {
      const message = error?.message || "Something went wrong.";

      if (/invalid login credentials/i.test(message)) {
        return "Incorrect email or password. Please check your details and try again.";
      }
      if (/email not confirmed/i.test(message)) {
        return "Your email has not been confirmed yet. Please check your inbox.";
      }
      if (/already registered/i.test(message)) {
        return "This email already has an account. Tap 'Sign in instead'.";
      }
      if (/too many requests/i.test(message)) {
        return "Too many attempts. Please wait a little before trying again.";
      }
      if (/network|fetch failed|failed to fetch/i.test(message)) {
        return "Connection problem. Check your internet and try again.";
      }
      return "Unable to continue: " + message;
    }

    $("authForm").addEventListener("submit", async (event) => {
      event.preventDefault();
      clearMessage("authMessage");

      if (authRequestInProgress) return;

      if (!sb) {
        showMessage("authMessage", "Supabase did not initialise. Check your internet connection and project settings.", "error");
        return;
      }

      const email = $("email").value.trim();
      const password = $("password").value;
      const name = $("displayName").value.trim();

      if (isSignup && !name) {
        showMessage("authMessage", "Please enter your full name.", "error");
        return;
      }

      if (password.length < 8) {
        showMessage("authMessage", "Your password must be at least 8 characters.", "error");
        return;
      }

      let registrationProfile = null;
      if (isSignup) {
        const path = $("signupLearningPath").value;
        const selectedSubjects = [...document.querySelectorAll(".signup-subject-choice:checked")].map(el => el.value);
        if (!["jamb", "waec_neco", "higher_institution"].includes(path)) { showMessage("authMessage", "Choose your learning path before creating your account.", "error"); return; }
        if (path === "jamb" && (selectedSubjects.length !== 4 || !selectedSubjects.includes("English Language"))) { showMessage("authMessage", "Choose exactly four JAMB subjects, including English Language.", "error"); return; }
        if (path === "waec_neco" && (selectedSubjects.length !== 9 || !$("signupExamChoice").value || !$("signupSchoolLevel").value)) { showMessage("authMessage", "Choose WAEC/NECO, your school level, and exactly nine subjects.", "error"); return; }
        if (path === "jamb" && !$("signupJambLevel").value) { showMessage("authMessage", "Choose your current school level.", "error"); return; }
        if (path === "higher_institution" && (!$("signupInstitutionName").value.trim() || !$("signupCourseName").value || !$("signupStudyLevel").value)) { showMessage("authMessage", "Enter your institution, course/programme and current level.", "error"); return; }
        registrationProfile = {
          learning_path: path,
          waec_neco_choice: path === "waec_neco" ? $("signupExamChoice").value : null,
          learning_level: path === "jamb" ? $("signupJambLevel").value : path === "waec_neco" ? $("signupSchoolLevel").value : $("signupStudyLevel").value,
          institution_name: path === "higher_institution" ? $("signupInstitutionName").value.trim() : null,
          course_name: path === "higher_institution" ? $("signupCourseName").value : null,
          study_level: path === "higher_institution" ? $("signupStudyLevel").value : null,
          subjects: path === "higher_institution" ? [] : selectedSubjects
        };
      }

      authRequestInProgress = true;
      $("authSubmit").disabled = true;
      $("authSubmit").textContent = "Please wait…";

      try {
        let result;

        if (isSignup) {
          result = await sb.auth.signUp({
            email,
            password,
            options: {
              data: { display_name: name, mivo_registration: registrationProfile }
            }
          });
        } else {
          result = await sb.auth.signInWithPassword({ email, password });
        }

        if (result.error) throw result.error;

        if (isSignup && !result.data.session) {
          showMessage(
            "authMessage",
            "Account registration was submitted with your selected learning path and subjects. Check your email for the confirmation link, then sign in. Mivo will sync your registration choices to your student profile.",
            "success"
          );
          return;
        }

        currentUser = result.data.user || result.data.session?.user || null;

        if (currentUser) {
          await afterAuthentication();
        }
      } catch (error) {
        showMessage("authMessage", friendlyError(error), "error");
      } finally {
        authRequestInProgress = false;
        $("authSubmit").disabled = false;
        updateAuthForm();
      }
    });

    async function initialiseSupabase() {
      try {
        if (!window.supabase?.createClient) {
          throw new Error("Supabase library did not load. Check your internet connection.");
        }

        sb = window.supabase.createClient(SUPABASE_URL, SUPABASE_KEY, {
          auth: {
            persistSession: true,
            autoRefreshToken: true,
            detectSessionInUrl: true
          }
        });

        const { data, error } = await sb.auth.getSession();
        if (error) throw error;

        currentUser = data.session?.user || null;

        setConnectionStatus("success", "Supabase client initialised.");

        sb.auth.onAuthStateChange((event, session) => {
          currentUser = session?.user || null;

          if (event === "SIGNED_OUT") {
            profileRow = null;
            $("adminNavButton").classList.add("hidden");
            showView("homeView");
          }
          // Sign-in is handled by the form submit flow below. Avoid repeating all
          // profile/dashboard/leaderboard requests from the auth event callback.
        });

        if (currentUser) {
          await afterAuthentication();
        } else {
          showView("homeView");
        }
      } catch (error) {
        setConnectionStatus("error", "Supabase setup error: " + (error.message || "Unable to initialise."));
      }
    }

    async function loadProfileFromDatabase() {
      if (!sb || !currentUser) {
        profileRow = null;
        return null;
      }

      const { data, error } = await sb
        .from("profiles")
        .select(`
          id,
          display_name,
          role,
          student_code,
          learning_path,
          waec_neco_choice,
          institution_name,
          institution_type,
          department,
          programme,
          course_name,
          study_level,
          learning_level,
          plan_tier,
          subscription_expires_at,
          suspended_at
        `)
        .eq("id", currentUser.id)
        .maybeSingle();

      if (error) {
        profileRow = null;
        console.error("Profile loading error:", error.message);
        throw error;
      }

      profileRow = data || null;

      if (profileRow?.suspended_at) {
        await sb.auth.signOut();
        currentUser = null;
        profileRow = null;
        $("adminNavButton").classList.add("hidden");
        showView("authView");
        showMessage("authMessage", "This account is suspended. Please contact the app owner.", "error");
        return null;
      }

      $("adminNavButton").classList.toggle(
        "hidden",
        !profileRow || profileRow.role !== "admin"
      );

      return profileRow;
    }

    async function syncRegistrationProfileMetadata() {
      if (!sb || !currentUser) return false;
      const metadata = currentUser.user_metadata || {};
      const registration = metadata.mivo_registration;
      if (!registration || !["jamb", "waec_neco", "higher_institution"].includes(registration.learning_path)) return false;
      const { data: existing, error: readError } = await sb.from("profiles").select("id,learning_path").eq("id", currentUser.id).maybeSingle();
      if (readError) throw readError;
      if (!existing) throw new Error("Your profile row has not been created yet. Check the Supabase handle_new_user trigger.");
      if (existing.learning_path && existing.learning_path !== registration.learning_path) return false;
      const profileUpdate = {
        display_name: metadata.display_name || currentUser.email?.split("@")[0] || "Student",
        learning_path: registration.learning_path,
        waec_neco_choice: registration.learning_path === "waec_neco" ? registration.waec_neco_choice : null,
        institution_name: registration.learning_path === "higher_institution" ? registration.institution_name : null,
        course_name: registration.learning_path === "higher_institution" ? registration.course_name : null,
        study_level: registration.learning_path === "higher_institution" ? registration.study_level : null,
        learning_level: registration.learning_level || null
      };
      if (!existing.learning_path) {
        const { error: updateError } = await sb.from("profiles").update(profileUpdate).eq("id", currentUser.id);
        if (updateError) throw updateError;
      }
      if (registration.learning_path === "jamb" || registration.learning_path === "waec_neco") {
        const { data: existingSubjects, error: subjectsReadError } = await sb.from("student_subjects").select("subject_name").eq("student_id", currentUser.id);
        if (subjectsReadError) throw subjectsReadError;
        if (!(existingSubjects || []).length && Array.isArray(registration.subjects) && registration.subjects.length) {
          const rows = registration.subjects.map(subject => ({ student_id: currentUser.id, subject_name: subject, learning_path: registration.learning_path }));
          const { error: subjectsInsertError } = await sb.from("student_subjects").insert(rows);
          if (subjectsInsertError) throw subjectsInsertError;
        }
      } else if (registration.learning_path === "higher_institution") {
        const { data: existingCourses, error: coursesReadError } = await sb.from("student_courses").select("course_name").eq("student_id", currentUser.id);
        if (coursesReadError) throw coursesReadError;
        if (!(existingCourses || []).length && registration.course_name) {
          const { error: courseInsertError } = await sb.from("student_courses").insert([{ student_id: currentUser.id, learning_path: "higher_institution", course_name: registration.course_name, institution_name: registration.institution_name, study_level: registration.study_level }]);
          if (courseInsertError) throw courseInsertError;
        }
      }
      return true;
    }

    async function afterAuthentication() {
      if (!sb || !currentUser) return;

      $("bottomNav").classList.remove("hidden");

      try {
        await loadProfileFromDatabase();
        if (profileRow && currentUser.user_metadata?.mivo_registration) {
          await syncRegistrationProfileMetadata();
          await loadProfileFromDatabase();
        }

        if (!currentUser) return;

        if (!profileRow) {
          showView("profileView");
          showMessage(
            "profileMessage",
            "Your account is signed in, but no profile row was found. Check that the Supabase handle_new_user trigger creates a profiles row for new users.",
            "error"
          );
          return;
        }

        await loadPoints();
        await Promise.allSettled([loadWeeklyLeaderboard(), loadRewardAccount(), loadRewardHistory(), loadSubscriptionSettings(), loadMySubscriptionPayments()]);
        if (profileRow?.role === 'admin') {
          await Promise.allSettled([loadAdminSubscriptionPayments(), loadAdminRewardAccounts()]);
        }
        showView("dashboardView"); // This view refreshes the dashboard once.

        setConnectionStatus("success", "Connected to Supabase. Your account is ready.");
      } catch (error) {
        console.error("Authentication setup error:", error);
        setConnectionStatus("error", "Could not finish loading your account: " + (error.message || "Please try again."));
        $("adminNavButton").classList.add("hidden");
      }
    }

    function populateProfileForm() {
      if (!profileRow) return;

      $("displayNameProfile").value = profileRow.display_name || "";
