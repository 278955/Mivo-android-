      if (Object.values(meta).some(v => typeof v === "string" && !v.trim()) && !meta.description) { showMessage(messageId, "Complete institution type, institution name, department, programme and level.", "error"); return; }
      if (!meta.institution_type || !meta.institution_name || !meta.department || !meta.programme || !meta.study_level) { showMessage(messageId, "Complete institution type, institution name, department, programme and level.", "error"); return; }
      button.disabled = true; let completed = 0; let failed = [];
      try {
        for (const file of files) {
          const title = file.name.replace(/\.pdf$/i, "").trim() || file.name;
          const lessonPayload = { id: crypto.randomUUID(), title, subject: title, course_name: title, description: meta.description, content: "", published: $("bulkLessonPublishNow").checked, institution_type: meta.institution_type, institution_name: meta.institution_name, department: meta.department, programme: meta.programme, study_level: meta.study_level, pdf_filename: file.name, file_size_bytes: file.size };
