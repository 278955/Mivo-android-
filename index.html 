    if (!targetId) return;
    const target = document.getElementById(targetId);
    const adminView = document.getElementById("adminView");
    const adminContent = document.getElementById("adminContent");
    if (!target || !adminView) return;
    // Do not bypass the app's existing authentication/owner checks.
    if (adminView.classList.contains("hidden") || !adminContent || adminContent.classList.contains("hidden")) {
      const msg = document.getElementById("globalMessage");
      if (msg) {
        msg.className = "message info";
        msg.textContent = "Please sign in with your authorised owner account and open Owner Dashboard first.";
        msg.classList.remove("hidden");
      }
      return;
    }
    target.scrollIntoView({ behavior: "smooth", block: "start" });
    target.style.outline = "2px solid #137a43";
    window.setTimeout(() => { target.style.outline = ""; }, 1400);
  }
  document.addEventListener("click", function (event) {
    const button = event.target.closest("button");
    if (!button || !targets[button.id]) return;
    event.preventDefault();
    navigateToPublisher(button.id);
  }, true);
  document.addEventListener("DOMContentLoaded", function () {
    Object.keys(targets).forEach(id => {
      const button = document.getElementById(id);
      if (button) button.setAttribute("aria-controls", targets[id]);
    });
  });
})();
</script>


