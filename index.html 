    async function loadLessons() {
      $("lessonsMessage").textContent = "Loading published lessons…";
      $("lessonsList").innerHTML = "";

      if (!sb) {
        $("lessonsMessage").textContent = "Supabase is not connected.";
        return;
      }

      try {
        const { data, error } = await sb.from("lessons")
          .select("id,title,subject,description,content,created_at,pdf_path,pdf_filename,institution_type,institution_name,department,programme,study_level,course_name")
