    // Extract PDF text in visual reading order. PDF.js item order can differ
    // from reading order, especially for multi-column exam papers.
    async function extractPdfTextInReadingOrder(pdf) {
      const pages = [];
      for (let pageNo = 1; pageNo <= pdf.numPages; pageNo++) {
        const page = await pdf.getPage(pageNo);
        const content = await page.getTextContent();
        const items = (content.items || [])
          .filter(item => item && typeof item.str === "string" && item.str.trim())
          .map(item => ({ text: item.str.trim(), x: Number(item.transform?.[4] || 0), y: Number(item.transform?.[5] || 0) }))
          .sort((a, b) => Math.abs(b.y - a.y) > 3 ? b.y - a.y : a.x - b.x);
        const rows = [];
        for (const item of items) {
          let row = rows.find(candidate => Math.abs(candidate.y - item.y) <= 3);
          if (!row) { row = { y: item.y, items: [] }; rows.push(row); }
          row.items.push(item);
        }
        rows.sort((a, b) => b.y - a.y);
        pages.push(rows.map(row => row.items.sort((a, b) => a.x - b.x)
          .map(item => item.text).join(" ").replace(/\s+/g, " ")).join("\n"));
      }
      return pages.join("\n");
    }

    function parsePdfQuestions(rawText) {
      // Robust parser for text extracted from PDF.js. It accepts numbered questions,
      // A-D options, and answer/explanation labels even when PDF line breaks vary.
      const text = String(rawText || '')
        .replace(/\r/g, '\n')
        .replace(/[\u00a0\t]+/g, ' ')
        .replace(/[ \f]+/g, ' ');
      const lines = text.split('\n').map(line => line.trim()).filter(Boolean);
      const blocks = [];
      let current = null;
      const startQuestion = /^(?:question\s*)?(\d{1,4})[.)\]:-]\s*(.*)$/i;
      const optionPattern = /^\s*(?:\(([A-D])\)|([A-D])[.)\]:-])\s*(.+)$/i;
      const answerPattern = /^\s*(?:correct\s+)?answer\s*[:.-]\s*\(?([A-D])\)?(?:\b|\s|$)/i;
      const explanationPattern = /^(?:explanation|solution|reason)\s*[:.-]\s*(.*)$/i;

      for (const originalLine of lines) {
        let line = originalLine.replace(/\s+/g, ' ').trim();
        // Some PDF.js layouts place a question number and its text in separate items.
        const start = line.match(startQuestion);
        if (start && !/^(19|20)\d{2}$/.test(start[1])) {
          if (current) blocks.push(current);
          current = { number: Number(start[1]), lines: start[2] ? [start[2]] : [] };
          continue;
        }
        // Ignore document headers and footers, but keep all question content.
        if (/^(MIVO|JAMB MOCK EXAMINATION|40 MULTIPLE-CHOICE PRACTICE QUESTIONS|PAGE \d+|Mivo • .*Mock Practice)$/i.test(line)) continue;
        if (current) current.lines.push(line);
      }
      if (current) blocks.push(current);

      const parsed = [];
      for (const block of blocks) {
        const questionLines = [];
        const options = {};
        let answer = '';
        const explanationLines = [];
        let inExplanation = false;
        for (const line of block.lines) {
          const ans = line.match(answerPattern);
          const exp = line.match(explanationPattern);
          const opt = line.match(optionPattern);
          if (ans) { answer = ans[1].toUpperCase(); inExplanation = false; continue; }
          if (exp) { inExplanation = true; if (exp[1]) explanationLines.push(exp[1]); continue; }
          if (inExplanation) { explanationLines.push(line); continue; }
          if (opt) { const letter = (opt[1] || opt[2] || '').toUpperCase(); const optionText = (opt[3] || '').trim(); if (letter && optionText) options[letter] = optionText; continue; }
          if (/^(?:answer key|answers)\s*[:.-]/i.test(line)) continue;
          questionLines.push(line);
        }
        const question = questionLines.join(' ').replace(/\s+/g, ' ').trim();
        if (question && ['A','B','C','D'].every(k => options[k])) {
          parsed.push({
            number: block.number,
            subject: '',
            question_text: question,
            options: ['A','B','C','D'].map(k => options[k]),
            correct_option: answer,
            explanation: explanationLines.join(' ').trim()
          });
        }
      }
      return parsed;
    }

