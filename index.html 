    function isProStudent() {
      if (String(profileRow?.plan_tier || "free").toLowerCase() !== "pro") return false;
      const expiry = profileRow?.subscription_expires_at;
      return !expiry || new Date(expiry).getTime() > Date.now();
    }

    const DAILY_QUIZ_SUBJECTS = ["English Language", "Mathematics", "Civic Education", "Biology"];
    function quizQuestionsPerSubject() { return isProStudent() ? 10 : 5; }
    function quizDailyLimit() { return quizQuestionsPerSubject() * DAILY_QUIZ_SUBJECTS.length; }
    function dailyQuizProgressKey() {
      return `mivo_daily_quiz_progress_${currentUser?.id || "guest"}_${new Date().toISOString().slice(0,10)}`;
    }
    function readDailyQuizProgress() {
      try {
        const saved = JSON.parse(localStorage.getItem(dailyQuizProgressKey()) || "{}");
        return { completed: Array.isArray(saved.completed) ? DAILY_QUIZ_SUBJECTS.filter(x => saved.completed.includes(x)) : [] };
      } catch (_) { return { completed: [] }; }
    }
    function saveDailyQuizProgress(progress) {
      try { localStorage.setItem(dailyQuizProgressKey(), JSON.stringify({ completed: DAILY_QUIZ_SUBJECTS.filter(x => progress.completed.includes(x)) })); } catch (_) {}
    }
    function nextDailyQuizSubject() {
      const progress = readDailyQuizProgress();
      return DAILY_QUIZ_SUBJECTS.find(subject => !progress.completed.includes(subject)) || "";
    }
    function updateDailyQuizJourney() {
      const progress = readDailyQuizProgress();
      const next = DAILY_QUIZ_SUBJECTS.find(subject => !progress.completed.includes(subject)) || "";
      const subjectBox = $("dailyQuizSubject"), startButton = $("loadQuizButton"), continueButton = $("continueQuizButton");
      if (subjectBox) subjectBox.innerHTML = next
        ? `<strong>Next subject: ${escapeHtml(next)}</strong><p class="muted">${quizQuestionsPerSubject()} questions · ${progress.completed.length} of 4 subjects completed today.</p>`
        : '<strong>🎉 You have completed all four subjects for today!</strong><p class="muted">Come back tomorrow for a new Daily Quiz.</p>';
      if (startButton) { startButton.classList.toggle("hidden", progress.completed.length > 0 || !next); startButton.disabled = !next; }
      if (continueButton) { continueButton.classList.toggle("hidden", progress.completed.length === 0 || !next); continueButton.disabled = !next; }
      const progressBox = $("dailyQuizProgress");
      if (progressBox) progressBox.textContent = `Today's progress: ${progress.completed.length}/4 completed${progress.completed.length ? " · " + progress.completed.join(" ✓ · ") : ""}. Order: English Language → Mathematics → Civic Education → Biology.`;
    }
    function applyQuizPlanControls() {
      const adSlot = $("adSlotDashboard");
      if (adSlot) adSlot.classList.toggle("hidden", isProStudent());
      updateDailyQuizJourney();
    }

    async function refreshQuizUsage() {
      if (!sb || !currentUser) return;
      const limit = quizDailyLimit();
      const today = new Date().toISOString().slice(0, 10);
      const usageBox = $("quizUsage");
      applyQuizPlanControls();
      usageBox.className = "message info";
      usageBox.textContent = "Checking today's quiz usage…";
      try {
        const { data, error } = await sb
          .from("daily_quiz_usage")
          .select("questions_used")
          .eq("user_id", currentUser.id)
          .eq("usage_date", today)
          .maybeSingle();
        if (error) throw error;
        const used = Number(data?.questions_used || 0);
        const completedCount = Math.min(DAILY_QUIZ_SUBJECTS.length, Math.floor(used / quizQuestionsPerSubject()));
        const progress = readDailyQuizProgress();
        const serverCompleted = DAILY_QUIZ_SUBJECTS.slice(0, completedCount);
        progress.completed = DAILY_QUIZ_SUBJECTS.filter(subject => progress.completed.includes(subject) || serverCompleted.includes(subject));
        saveDailyQuizProgress(progress);
        updateDailyQuizJourney();
        usageBox.textContent =
          `${String(profileRow?.plan_tier || "free").toUpperCase()} plan · ${used}/${limit} questions used today (UTC). ` +
          `${Math.max(0, limit - used)} remaining. The server enforces the daily question total.`;
      } catch (error) {
        usageBox.className = "message error";
        usageBox.textContent = "Could not check daily usage: " + (error.message || "Unknown error");
      }
    }

    async function loadQuizQuestions() {
      if (!sb || !currentUser || !profileRow) {
        showMessage("quizMessage", "Please sign in and complete your student profile first.", "error");
        return;
      }
      const subject = nextDailyQuizSubject();
      if (!subject) {
        updateDailyQuizJourney();
        showMessage("quizMessage", "You have completed all four Daily Quiz subjects for today. Come back tomorrow!", "success");
        return;
      }
      const button = $("loadQuizButton").classList.contains("hidden") ? $("continueQuizButton") : $("loadQuizButton");
      button.disabled = true;
      $("loadQuizButton").classList.add("hidden");
      $("continueQuizButton").classList.add("hidden");
      const oldLabel = button.textContent;
      button.textContent = "Loading questions…";
      $("quizForm").classList.add("hidden");
      $("quizResult").innerHTML = "";
      clearMessage("quizMessage");
      activeQuizQuestions = [];
      activeQuizRequestId = null;
      quizAlreadySubmitted = false;

      try {
        const { data, error } = await sb.from("quiz_questions")
          .select("id,learning_path,subject,exam_type,question_text,options,explanation")
          .eq("published", true).eq("exam_type", "daily_quiz").eq("subject", subject).limit(200);
        if (error) throw error;
        const questions = (data || []).filter(q => Array.isArray(q.options) && q.options.length >= 2 && q.question_text && q.options.every(option => typeof option === "string"));
        if (questions.length < quizQuestionsPerSubject()) {
          throw new Error(`Only ${questions.length} valid published questions are available for ${subject}; ${quizQuestionsPerSubject()} are required.`);
        }
        for (let i = questions.length - 1; i > 0; i--) { const j = Math.floor(Math.random() * (i + 1)); [questions[i], questions[j]] = [questions[j], questions[i]]; }
        activeQuizQuestions = questions.slice(0, quizQuestionsPerSubject());
        activeQuizRequestId = crypto.randomUUID();
        activeQuizSubject = subject;
        $("quizQuestions").innerHTML = activeQuizQuestions.map((q, index) => `
          <article class="lesson">
            <p class="small">${escapeHtml(subject)} · Question ${index + 1} of ${activeQuizQuestions.length}</p>
            <h3>${escapeHtml(q.question_text)}</h3>
            <div class="choice-list">${q.options.map((option, optionIndex) => `
              <label class="choice"><input type="radio" name="quiz_${escapeHtml(q.id)}" value="${escapeHtml(option)}"><span>${String.fromCharCode(65 + optionIndex)}. ${escapeHtml(option)}</span></label>
            `).join("")}</div>
          </article>`).join("");
        $("quizForm").classList.remove("hidden");
        $("submitQuizButton").textContent = `Submit ${subject} quiz`;
        startTimedAssessment("quiz", "quizQuestions", "quizForm", "quiz_", activeQuizQuestions.length);
        showMessage("quizMessage", `${subject} is ready: ${activeQuizQuestions.length} questions. Complete this subject to unlock the next one.`, "success");
      } catch (error) {
        showMessage("quizMessage", "Could not load quiz: " + (error.message || "Unknown error"), "error");
        updateDailyQuizJourney();
      } finally {
        button.disabled = false;
        button.textContent = oldLabel;
      }
    }

    async function submitQuizAnswers(event) {
      event.preventDefault();
      if (quizSubmissionInProgress || quizAlreadySubmitted) return;
      if (!sb || !currentUser || !activeQuizQuestions.length || !activeQuizRequestId) {
        showMessage("quizMessage", "Load a quiz before submitting.", "error");
        return;
      }

      stopAssessmentTimer("quiz");
      const answers = [];
      const unanswered = [];
      for (const [index, q] of activeQuizQuestions.entries()) {
        const chosen = document.querySelector(`input[name="quiz_${CSS.escape(String(q.id))}"]:checked`);
        if (!chosen || !String(chosen.value || "").trim()) {
          unanswered.push(index + 1);
          continue;
        }
        const optionText = String(chosen.value).trim();
        const validOptions = Array.isArray(q.options) ? q.options.map(value => String(value).trim()) : [];
        if (!validOptions.includes(optionText)) {
          showMessage("quizMessage", `Question ${index + 1} has an invalid answer option. Please reload the quiz and try again.`, "error");
          return;
        }
        answers.push({ question_id: Number(q.id), selected_answer: optionText });
      }
      if (unanswered.length) {
        showMessage("quizMessage", `Please answer every question before submitting. Unanswered question(s): ${unanswered.join(", ")}.`, "error");
        const firstUnanswered = activeQuizQuestions[unanswered[0] - 1];
        document.querySelector(`input[name="quiz_${CSS.escape(String(firstUnanswered.id))}"]`)?.closest(".lesson")?.scrollIntoView({ behavior: "smooth", block: "center" });
        return;
      }

      const button = $("submitQuizButton");
      quizSubmissionInProgress = true;
      button.disabled = true;
      button.textContent = "Submitting…";
      try {
        const { data, error } = await sb.rpc("submit_quiz", {
          p_request_id: activeQuizRequestId,
          p_quiz_name: `${activeQuizSubject} Daily Quiz`,
          p_answers: answers
        });
        if (error) throw error;
        if (!data || data.success !== true) throw new Error("The server did not confirm this quiz submission.");

        quizAlreadySubmitted = true;
        const progress = readDailyQuizProgress();
        if (!progress.completed.includes(activeQuizSubject)) progress.completed.push(activeQuizSubject);
        saveDailyQuizProgress(progress);
        mivoResultSound(Number(data.score), Number(data.total_questions));
        stopAssessmentTimer("quiz");
        $("quizQuestions").querySelectorAll("input").forEach((input) => { input.disabled = true; });
        button.textContent = "Quiz submitted";
        $("quizResult").innerHTML = `
          <div class="card">
            <h3>Quiz result</h3>
            <p class="stat-number">${Number(data.score)} / ${Number(data.total_questions)}</p>
            <p><strong>Points awarded:</strong> ${Number(data.points_awarded)} points</p>
            <p class="muted">Daily allowance: ${Number(data.questions_used_today)} / ${Number(data.daily_limit)} questions used.</p>
            <p class="muted">Your score and points were recorded by the secure server.</p>
          </div>
          <h3>Review</h3>
          ${activeQuizQuestions.map((q, index) => {
            const chosen = answers.find((a) => String(a.question_id) === String(q.id))?.selected_answer;
            return `<article class="lesson">
              <strong>${index + 1}. ${escapeHtml(q.question_text)}</strong>
              <p>Your answer: ${escapeHtml(chosen || "")}</p>
              ${q.explanation ? `<p class="muted">Explanation: ${escapeHtml(q.explanation)}</p>` : ""}
            </article>`;
          }).join("")}
        `;
        showMessage("quizMessage", `${activeQuizSubject} completed successfully.`, "success");
        await refreshQuizUsage();
        updateDailyQuizJourney();
        if (nextDailyQuizSubject()) {
          $("continueQuizButton").classList.remove("hidden");
          $("continueQuizButton").textContent = `Continue to ${nextDailyQuizSubject()}`;
        } else {
          $("continueQuizButton").classList.add("hidden");
          $("loadQuizButton").classList.add("hidden");
        }
      } catch (error) {
        // Keep the same request ID on retries so an uncertain network response cannot award twice.
        showMessage("quizMessage", "Quiz submission failed: " + (error.message || "Unknown error") + ". You can retry without creating a duplicate score.", "error");
        button.textContent = "Retry submission";
      } finally {
        quizSubmissionInProgress = false;
        button.disabled = false;
      }
    }

