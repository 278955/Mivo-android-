    $("profileForm").addEventListener("submit", async (event) => {
      event.preventDefault();
      clearMessage("profileMessage");

      if (!sb || !currentUser) {
        showMessage("profileMessage", "Please sign in before saving your learning profile.", "error");
        return;
      }

      if (!profileRow) {
        showMessage("profileMessage", "Your Supabase profiles row is missing. Check the handle_new_user trigger before trying again.", "error");
        return;
      }

      const path = $("learningPath").value;

      if (!["jamb", "waec_neco", "higher_institution"].includes(path)) {
        showMessage("profileMessage", "Choose a valid learning path.", "error");
        return;
      }

      const selectedSubjects = [
        ...document.querySelectorAll(".subject-choice:checked")
      ].map((el) => el.value);

      const selectedCourses = [
        ...document.querySelectorAll(".course-choice:checked")
      ].map((el) => el.value);

      if (path === "jamb" && selectedSubjects.length !== 4) {
        showMessage("profileMessage", `Choose exactly four JAMB subjects. You currently selected ${selectedSubjects.length}.`, "error");
        return;
      }
      if (path === "jamb" && !selectedSubjects.includes("English Language")) {
        showMessage("profileMessage", "English Language must be included in your four JAMB subjects.", "error");
        return;
      }
      if (path === "waec_neco" && selectedSubjects.length !== 9) {
        showMessage("profileMessage", `Choose exactly nine WAEC/NECO subjects. You currently selected ${selectedSubjects.length}.`, "error");
        return;
      }

      if (path === "waec_neco" && !$("examChoice").value) {
        showMessage("profileMessage", "Choose WAEC, NECO or both.", "error");
        return;
      }

      if (path === "jamb" && !$("jambLevel").value) {
        showMessage("profileMessage", "Choose your current school level.", "error");
        return;
      }

      if (path === "waec_neco" && !$("schoolLevel").value) {
        showMessage("profileMessage", "Choose your current school level.", "error");
        return;
      }

      if (path === "higher_institution") {
        const requiredIds = ["institutionName", "faculty", "programme", "studyLevel", "semester"];

        if (requiredIds.some((id) => !$(id).value.trim())) {
          showMessage("profileMessage", "Complete the institution, faculty, programme, level and semester fields.", "error");
          return;
        }

        if (!selectedCourses.length) {
          showMessage("profileMessage", "Select at least one course.", "error");
          return;
        }
      }

      const saveButton = $("saveProfile");
      saveButton.disabled = true;
      saveButton.textContent = "Saving…";

      try {
        const displayName = $("displayNameProfile").value.trim();

        const update = {
          display_name: displayName,
          learning_path: path,
          waec_neco_choice: path === "waec_neco" ? $("examChoice").value : null,
          institution_name: path === "higher_institution" ? $("institutionName").value.trim() : null,
          course_name: path === "higher_institution" ? $("programme").value : null,
          study_level: path === "higher_institution" ? $("studyLevel").value : null,
          learning_level: path === "higher_institution"
            ? $("studyLevel").value
            : path === "jamb" ? $("jambLevel").value : $("schoolLevel").value
        };

        // Never allow the browser to set role, plan tier, student ID or rewards.
        const { data: updatedProfile, error: profileError } = await sb
          .from("profiles")
          .update(update)
          .eq("id", currentUser.id)
          .select("id,display_name,role,student_code,learning_path,waec_neco_choice,institution_name,course_name,study_level,learning_level,plan_tier,suspended_at")
          .maybeSingle();

        if (profileError) throw profileError;

        if (!updatedProfile) {
          throw new Error("No profile row was updated. Check your profiles table and UPDATE policy.");
        }

        const { error: deleteSubjectsError } = await sb.from("student_subjects")
          .delete()
          .eq("student_id", currentUser.id);

        if (deleteSubjectsError) throw deleteSubjectsError;

        if ((path === "jamb" || path === "waec_neco") && selectedSubjects.length) {
          const rows = selectedSubjects.map((subject) => ({
            student_id: currentUser.id,
            subject_name: subject,
            learning_path: path
          }));

          const { error } = await sb.from("student_subjects").insert(rows);
          if (error) throw error;
        }

        const { error: deleteCoursesError } = await sb.from("student_courses")
          .delete()
          .eq("student_id", currentUser.id);

        if (deleteCoursesError) throw deleteCoursesError;

        if (path === "higher_institution" && selectedCourses.length) {
          const rows = selectedCourses.map((course) => ({
            student_id: currentUser.id,
            learning_path: path,
            course_name: course,
            institution_name: $("institutionName").value.trim(),
            study_level: $("studyLevel").value
          }));

          const { error } = await sb.from("student_courses").insert(rows);
          if (error) throw error;
        }

        profileRow = updatedProfile;

        await loadProfileFromDatabase();
        await loadPoints();
        await refreshDashboard();

        showMessage("profileMessage", "Your learning profile was saved to Supabase.", "success");
      } catch (error) {
        showMessage("profileMessage", "Could not fully save your profile: " + (error.message || "Unknown error"), "error");
      } finally {
        saveButton.disabled = false;
        saveButton.textContent = "Save learning profile";
      }
    });

