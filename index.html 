    // One-question-at-a-time countdown shared by Daily Quiz and Daily Mock.
    const mdAssessmentTimers = Object.create(null);
    function stopAssessmentTimer(key) {
      const state = mdAssessmentTimers[key];
      if (state?.interval) clearInterval(state.interval);
      if (state) state.interval = null;
    }
    function startTimedAssessment(key, containerId, formId, namePrefix, questionCount) {
      stopAssessmentTimer(key);
      if (key === "mock") {
        const container = $(containerId), form = $(formId);
        const cards = [...container.querySelectorAll(':scope > article.lesson')];
        if (!cards.length) return;
        const oldTimer = container.querySelector('.md-question-timer');
        if (oldTimer) oldTimer.remove();
        const totalSeconds = 25 * cards.length; // Preserve the existing 25 seconds per question.
        const timerBox = document.createElement('div');
        timerBox.className = 'md-question-timer md-mock-clock';
        timerBox.setAttribute('role','timer');
        timerBox.setAttribute('aria-live','off');
        timerBox.innerHTML = `<div class="md-mock-clock-ring"><svg viewBox="0 0 120 120" aria-hidden="true"><circle class="md-mock-clock-track" cx="60" cy="60" r="51"></circle><circle class="md-mock-clock-progress" cx="60" cy="60" r="51" stroke-dasharray="320.44" stroke-dashoffset="0"></circle></svg><div class="md-mock-clock-time">16:40</div></div><div class="md-mock-clock-caption">Time remaining</div><div class="small">40-question mock examination</div>`;
        container.prepend(timerBox);
        const timeText = timerBox.querySelector('.md-mock-clock-time');
        const progress = timerBox.querySelector('.md-mock-clock-progress');
        const state = { seconds:totalSeconds, totalSeconds, interval:null, cards, container, form, timerBox, index:0, advancing:false, finished:false };
        mdAssessmentTimers[key] = state;
        cards.forEach((card,i)=>card.classList.toggle('hidden',i!==0));
        function renderClock(){
          const mins=Math.floor(state.seconds/60), secs=state.seconds%60;
          timeText.textContent=`${String(mins).padStart(2,'0')}:${String(secs).padStart(2,'0')}`;
          progress.style.strokeDashoffset=String(320.44*(1-state.seconds/totalSeconds));
          timerBox.classList.toggle('urgent',state.seconds<=10 && state.seconds>0);
          timerBox.classList.toggle('finished',state.seconds<=0);
        }
        function finish(){
          if(state.finished || mdAssessmentTimers[key]!==state)return;
          state.finished=true;
          if(state.interval)clearInterval(state.interval);
          state.interval=null;
          state.seconds=0;renderClock();
          timerBox.querySelector('.md-mock-clock-caption').textContent='Time is up — submitting';
          cards.forEach(card=>card.classList.add('hidden'));
          form.querySelectorAll('input').forEach(input=>input.disabled=true);
          setTimeout(()=>{if(form&&!form.dataset.timerSubmitted){form.dataset.timerSubmitted='1';form.requestSubmit();}},250);
        }
        function advance(){
          if(state.finished || state.advancing || mdAssessmentTimers[key]!==state)return;
          state.advancing=true;
          if(state.index<cards.length-1){state.index++;cards.forEach((card,i)=>card.classList.toggle('hidden',i!==state.index));}
          state.advancing=false;
        }
        state.advance=advance;
        if(!container.dataset.timerListener){
          container.addEventListener('change',event=>{
            const input=event.target;
            if(!input.matches('input[type="radio"]'))return;
            const active=mdAssessmentTimers[key];
            if(!active||active.finished||!active.cards[active.index]?.contains(input))return;
            if(active.index<active.cards.length-1)setTimeout(()=>active.advance(),150);
          });
          container.dataset.timerListener='1';
        }
        form.dataset.timerSubmitted='';
        renderClock();
        state.interval=setInterval(()=>{
          if(mdAssessmentTimers[key]!==state||state.finished){clearInterval(state.interval);return;}
          state.seconds=Math.max(0,state.seconds-1);
          renderClock();
          if(state.seconds<=5 && state.seconds>=1)mivoSound('tick');
          if(state.seconds<=0)finish();
        },1000);
        return;
      }
      const container = $(containerId);
      const form = $(formId);
      const cards = [...container.querySelectorAll(':scope > article.lesson')];
      if (!cards.length) return;
      const oldTimer = container.querySelector('.md-question-timer');
      if (oldTimer) oldTimer.remove();
      const timerBox = document.createElement('div');
      timerBox.className = 'md-question-timer message info';
      timerBox.setAttribute('role', 'status');
      timerBox.setAttribute('aria-live', 'polite');
      container.prepend(timerBox);
      const secondsPerQuestion = key === "mock" ? 25 : 20;
      const state = { index: 0, seconds: secondsPerQuestion, secondsPerQuestion, interval: null, cards, container, form, namePrefix, questionCount, timerBox, advancing: false };
      mdAssessmentTimers[key] = state;
      function draw() {
        state.cards.forEach((card, i) => card.classList.toggle('hidden', i !== state.index));
        state.seconds = state.secondsPerQuestion;
        state.timerBox.className = 'md-question-timer message info';
        state.timerBox.textContent = `⏱️ Question ${state.index + 1} of ${state.cards.length} · ${state.seconds} seconds remaining`;
        if (state.interval) clearInterval(state.interval);
        state.interval = setInterval(() => {
          if (mdAssessmentTimers[key] !== state) { clearInterval(state.interval); return; }
          state.seconds -= 1;
          state.timerBox.textContent = `⏱️ Question ${state.index + 1} of ${state.cards.length} · ${state.seconds} seconds remaining`;
          if (state.seconds <= 5) { state.timerBox.className = 'md-question-timer message error'; mivoSound('tick'); }
          if (state.seconds <= 0) advance(true);
        }, 1000);
      }
      function advance(timedOut = false) {
        if (state.advancing || mdAssessmentTimers[key] !== state) return;
        state.advancing = true;
        if (state.interval) clearInterval(state.interval);
        state.interval = null;
        if (timedOut) state.timerBox.textContent = `⏱️ Time is up for question ${state.index + 1}. Moving on…`;
        state.index += 1;
        if (state.index >= state.cards.length) {
          state.timerBox.textContent = '⏱️ All questions completed. Submitting your answers…';
          state.cards.forEach(card => card.classList.add('hidden'));
          setTimeout(() => { if (form && !form.dataset.timerSubmitted) { form.dataset.timerSubmitted = '1'; form.requestSubmit(); } }, 250);
          return;
        }
        state.advancing = false;
        draw();
      }
      state.advance = advance;
      if (!container.dataset.timerListener) {
        container.addEventListener('change', event => {
          const input = event.target;
          if (!input.matches('input[type="radio"]')) return;
          const active = mdAssessmentTimers[key];
          if (!active || !active.cards[active.index]?.contains(input)) return;
          setTimeout(() => active.advance(false), 150);
        });
        container.dataset.timerListener = '1';
      }
      form.dataset.timerSubmitted = '';
      draw();
    }
